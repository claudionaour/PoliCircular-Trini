# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE: La configuración principal de Firebase se carga desde firebase-applet-config.json.
# Opcional: Clave Web Push (VAPID) de Firebase Cloud Messaging para notificaciones push en navegadores compatibles.
VITE_FIREBASE_VAPID_KEY=""
# Opcional: Activar invocación de Cloud Functions desplegadas ("true" | "false").
VITE_ENABLE_CLOUD_FUNCTIONS="false"
